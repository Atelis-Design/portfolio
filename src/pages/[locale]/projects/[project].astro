---
import Photo from '../../../components/Photo.astro';
import ProjectGallery from '../../../components/ProjectGallery.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getProject, getProjectIds } from '../../../data';
import { LOCALES, type Locale } from '../../../i18n/locales';
import { localizedPath, projectPath } from '../../../i18n/routes';
import { useUi } from '../../../i18n/ui';

export function getStaticPaths() {
  return LOCALES.flatMap((locale) => getProjectIds().map((project) => ({ params: { locale, project } })));
}

const locale = Astro.params.locale as Locale;
const project = getProject(Astro.params.project as string, locale);
if (!project) throw new Error(`Unknown project: ${Astro.params.project}`);

const ui = useUi(locale);
const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout
  locale={locale}
  title={project.seoTitle ?? project.title}
  description={project.seoDescription}
  current="projects"
  ogType="article"
>
  <article class="project">
    <header class="project__head container grid">
      <p class="project__back">
        <a href={localizedPath(locale, 'projects')}>
          <span aria-hidden="true">←</span>
          {ui.common.backToProjects}
        </a>
      </p>
      <p class="project__index" aria-hidden="true">
        {pad(project.index)} / {pad(project.total)}
      </p>
      <h1 class="project__title">{project.title}</h1>
      {
        project.meta.length > 0 && (
          <dl class="project__meta">
            {project.meta.map((item) => (
              <div>
                <dt class="eyebrow">{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </header>

    <figure class="project__hero">
      <Photo image={project.hero} sizes="100vw" priority />
    </figure>

    <section class="project__intro section container grid" aria-labelledby="project-story">
      <h2 class="project__label eyebrow" id="project-story">{ui.project.story}</h2>
      <p class="project__lead statement">{project.shortDescription}</p>
      {
        project.story.length > 0 && (
          <div class="project__story prose">
            {project.story.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        )
      }
    </section>

    <ProjectGallery blocks={project.gallery} />

    {
      project.credits.length > 0 && (
        <section class="project__credits section container grid" aria-labelledby="project-credits">
          <h2 class="eyebrow" id="project-credits">
            {ui.project.credits}
          </h2>
          <dl>
            {project.credits.map((credit) => (
              <div>
                <dt>{credit.role}</dt>
                <dd>{credit.name}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }
  </article>

  <nav class="pager container" aria-label={ui.a11y.projectNav}>
    <a class="pager__link pager__link--prev" href={projectPath(locale, project.previous.id)} rel="prev">
      <span class="eyebrow">{ui.common.previousProject}</span>
      <span class="pager__title">{project.previous.title}</span>
    </a>
    <a class="pager__all link-arrow" href={localizedPath(locale, 'projects')}>{ui.common.allProjects}</a>
    <a class="pager__link pager__link--next" href={projectPath(locale, project.next.id)} rel="next">
      <span class="eyebrow">{ui.common.nextProject}</span>
      <span class="pager__title">{project.next.title}</span>
    </a>
  </nav>
</BaseLayout>

<style>
  .project__head {
    padding-block: var(--space-lg) var(--space-xl);
    row-gap: var(--space-md);
    align-items: end;
  }

  .project__back a {
    display: inline-flex;
    gap: 0.5em;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-text-secondary);
  }

  .project__back a:hover {
    color: var(--color-text-primary);
    text-decoration: underline;
  }

  .project__index {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .project__title {
    font-size: var(--text-2xl);
  }

  .project__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-xl);
  }

  .project__hero :global(img) {
    width: 100%;
  }

  .project__intro {
    row-gap: var(--space-lg);
  }

  @media (min-width: 64em) {
    .project__back {
      grid-column: 1 / span 6;
    }

    .project__index {
      grid-column: 7 / span 6;
      justify-self: end;
    }

    .project__title {
      grid-column: 1 / span 8;
    }

    .project__meta {
      grid-column: 9 / span 4;
      justify-self: end;
    }

    .project__label {
      grid-column: 1 / span 3;
    }

    .project__lead {
      grid-column: 4 / span 7;
    }

    .project__story {
      grid-column: 4 / span 5;
    }
  }

  .project__credits dl {
    display: grid;
    gap: var(--space-xs);
  }

  @media (min-width: 64em) {
    .project__credits h2 {
      grid-column: 1 / span 3;
    }

    .project__credits dl {
      grid-column: 4 / span 6;
    }
  }

  /* Previous / next */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg) var(--grid-gap);
    margin-top: var(--space-section);
    padding-top: var(--space-lg);
    border-top: var(--rule);
  }

  .pager__link {
    display: grid;
    gap: var(--space-2xs);
    text-decoration: none;
  }

  .pager__link--next {
    text-align: right;
    justify-items: end;
  }

  .pager__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
  }

  .pager__link:hover .pager__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  .pager__all {
    grid-column: 1 / -1;
    grid-row: 2;
    justify-self: center;
  }

  @media (min-width: 48em) {
    .pager {
      grid-template-columns: 1fr auto 1fr;
      align-items: end;
    }

    .pager__all {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
