---
/**
 * Project detail: back link · viewer (active image | information panel) ·
 * thumbnail strip · compact previous / all / next navigation.
 *
 * Project order, numbering and previous/next come from the canonical order
 * shared with the Projects index (getProject → listingOrder). Only facts that
 * exist are shown; nothing is invented.
 */
import ProjectViewer from '../../../components/ProjectViewer.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getProject, getProjectIds } from '../../../data';
import { LOCALES, type Locale } from '../../../i18n/locales';
import { localizedPath, projectPath } from '../../../i18n/routes';
import { useUi } from '../../../i18n/ui';

export function getStaticPaths() {
  return LOCALES.flatMap((locale) => getProjectIds().map((project) => ({ params: { locale, project } })));
}

const locale = Astro.params.locale as Locale;
const project = getProject(Astro.params.project as string, locale);
if (!project) throw new Error(`Unknown project: ${Astro.params.project}`);

const ui = useUi(locale);
const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout
  locale={locale}
  title={project.seoTitle ?? project.title}
  description={project.seoDescription}
  current="projects"
  ogType="article"
  ogImage={project.socialImage.src}
  ogImageAlt={project.socialImage.alt}
>
  <article class="project">
    <p class="project__back container">
      <a href={localizedPath(locale, 'projects')}>
        <span class="project__back-arrow" aria-hidden="true">←</span>
        {ui.common.backToProjects}
      </a>
    </p>

    <ProjectViewer locale={locale} title={project.title} images={project.images}>
      <p class="info__count" aria-hidden="true">
        <span>{pad(project.index)}</span>
        <span class="info__count-line"></span>
        <span>{pad(project.total)}</span>
      </p>
      <h1 class="info__title">{project.title}</h1>
      <div class="info__category">
        <span class="info__rule" aria-hidden="true"></span>
        <p class="info__label">{project.categoryLabel}</p>
      </div>
      {project.intro && <p class="info__intro">{project.intro}</p>}
      {
        project.meta.length > 0 && (
          <dl class="info__meta">
            {project.meta.map((item) => (
              <div class="info__row">
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </ProjectViewer>
  </article>

  <nav class="project-nav container" aria-label={ui.a11y.projectNav}>
    <a class="project-nav__link project-nav__link--prev" href={projectPath(locale, project.previous.id)} rel="prev">
      <span class="project-nav__label"><span class="project-nav__arrow" aria-hidden="true">←</span>{ui.common.previousProject}</span>
      <span class="project-nav__title">{project.previous.title}</span>
    </a>
    <a class="project-nav__all" href={localizedPath(locale, 'projects')}>{ui.common.allProjects}</a>
    <a class="project-nav__link project-nav__link--next" href={projectPath(locale, project.next.id)} rel="next">
      <span class="project-nav__label">{ui.common.nextProject}<span class="project-nav__arrow" aria-hidden="true">→</span></span>
      <span class="project-nav__title">{project.next.title}</span>
    </a>
  </nav>
</BaseLayout>

<style>
  .project {
    font-family: var(--font-brand);
  }

  /* ← TÜM PROJELERE DÖN */
  .project__back {
    padding-block: var(--space-sm) var(--space-xs);
  }

  .project__back a {
    display: inline-flex;
    align-items: center;
    gap: 0.9em;
    min-height: 2.75rem;
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-text-secondary);
    transition: color var(--duration-fast) var(--ease);
  }

  .project__back-arrow {
    font-size: var(--text-sm);
    letter-spacing: 0;
    transition: transform var(--duration-fast) var(--ease);
  }

  .project__back a:hover {
    color: var(--color-text-primary);
  }

  /* Information panel (content of the viewer's panel) ------------------------ */

  /* 01 — 04: same numeral treatment as the Projects index counter */
  .info__count {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-numeric);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums lining-nums;
    color: var(--color-text-primary);
  }

  .info__count-line {
    width: 1.5rem;
    height: 1px;
    background: currentColor;
  }

  .info__title {
    margin-top: var(--space-md);
    font-family: var(--font-brand);
    font-size: var(--text-xl);
    line-height: 1.02;
  }

  /* Short rule under the title, category at the right */
  .info__category {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .info__rule {
    flex: 0 0 5.5rem;
    height: 1px;
    background: var(--color-text-secondary);
  }

  .info__label {
    margin-left: auto;
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  /* One concise sentence (heroIntro) */
  .info__intro {
    max-width: 32rem;
    margin-top: var(--space-lg);
    font-size: var(--text-md);
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  /* PROJE TÜRÜ · KONUM · YIL · ALAN · KAPSAM — rendered only for facts that exist */
  /*
   * One label column for all rows: 38% of the panel, widened only when a label is
   * longer than that (DE "Leistungsumfang" in a narrow panel), so values stay aligned.
   */
  .info__meta {
    display: grid;
    grid-template-columns: minmax(max(6.5rem, 38%), max-content) 1fr;
    gap: 0.55rem var(--space-md);
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: var(--rule);
  }

  .info__row {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    align-items: baseline;
  }

  .info__row dt {
    font-size: var(--text-2xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .info__row dd {
    font-size: var(--text-base);
    color: var(--color-text-primary);
  }

  /*
   * Beside the stage (from 64em) the panel should end where the image ends, and the
   * image gets shorter with the viewport while the type does not. Type sizes stay as
   * they are; only spacing and leading give way: tightest up to a 90rem viewport,
   * the full rhythm from 120rem. --info-room runs 0 → 30rem across that range.
   */
  @media (min-width: 64em) {
    .project {
      --info-room: clamp(0rem, 100vw - 90rem, 30rem);
      /* 1.125rem → 2.75rem (--space-lg) */
      --info-gap: calc(1.125rem + var(--info-room) * 0.0542);
      /* 0.75rem → 1.25rem (--space-md) */
      --info-gap-sm: calc(0.75rem + var(--info-room) / 60);
    }

    .info__title,
    .info__category {
      margin-top: var(--info-gap-sm);
    }

    .info__intro {
      margin-top: var(--info-gap);
      line-height: calc(1.8125rem + var(--info-room) / 240);
    }

    .info__meta {
      row-gap: calc(0.375rem + var(--info-room) * 0.00583);
      margin-top: var(--info-gap);
      /* keeps the image counter clear of the last fact when the panel is full */
      margin-bottom: var(--space-xs);
      padding-top: var(--info-gap-sm);
    }

    .info__row dd {
      line-height: calc(1.3125rem + var(--info-room) * 0.01125);
    }
  }

  /* Previous · all · next: compact, one quiet band above the footer ------------- */
  .project-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: var(--space-sm) var(--grid-gap);
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: var(--rule);
  }

  .project-nav__link {
    display: grid;
    gap: 0.2rem;
    align-content: end;
    min-height: 2.75rem;
    text-decoration: none;
  }

  .project-nav__link--next {
    justify-items: end;
    text-align: right;
  }

  .project-nav__label {
    display: inline-flex;
    align-items: center;
    gap: 0.75em;
    font-size: var(--text-2xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .project-nav__arrow {
    font-size: var(--text-sm);
    letter-spacing: 0;
    transition: transform var(--duration-fast) var(--ease);
  }

  .project-nav__title {
    font-family: var(--font-brand);
    font-size: clamp(1.125rem, 1rem + 0.45vw, 1.375rem);
    line-height: 1.25;
    color: var(--color-text-primary);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .project-nav__all {
    grid-column: 1 / -1;
    grid-row: 2;
    justify-self: center;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-text-secondary);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
  }

  @media (hover: hover) and (pointer: fine) {
    .project__back a:hover .project__back-arrow,
    .project-nav__link--prev:hover .project-nav__arrow {
      transform: translateX(-3px);
    }

    .project-nav__link--next:hover .project-nav__arrow {
      transform: translateX(3px);
    }

    .project-nav__link:hover .project-nav__title,
    .project-nav__all:hover {
      text-decoration-line: underline;
      color: var(--color-text-primary);
    }
  }

  @media (min-width: 48em) {
    .project-nav {
      grid-template-columns: 1fr auto 1fr;
    }

    .project-nav__all {
      grid-column: 2;
      grid-row: 1;
      align-self: end;
    }
  }
</style>
