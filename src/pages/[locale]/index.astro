---
import HomeHero from '../../components/HomeHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { HOME, localize } from '../../data';
import { localeStaticPaths, type Locale } from '../../i18n/locales';

export const getStaticPaths = localeStaticPaths;

const locale = Astro.params.locale as Locale;
---

<BaseLayout
  locale={locale}
  title={localize(HOME.meta.title, locale)}
  description={localize(HOME.meta.description, locale)}
  current="home"
  shell="viewport"
  ogImage={HOME.hero.slides[0].image.src}
  ogImageAlt={`L’Inconnue — Atelis Design`}
  websiteSchema
>
  <HomeHero locale={locale} />
</BaseLayout>
