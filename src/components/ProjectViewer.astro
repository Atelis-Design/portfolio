---
/**
 * Project viewer: active image (stage) + information panel + thumbnail strip +
 * full-screen gallery (native <dialog>). Vanilla JS, no dependencies.
 *
 *   stage      the active image; click → full-screen gallery
 *   panel      the page's project information (default slot) + ← | → controls
 *   strip      every image as a thumbnail; click selects, horizontal scroll
 *   lightbox   modal dialog: ← → / swipe, Escape, counter, focus returns
 *
 * One index drives everything and wraps around (last → first). Changing the
 * image never changes the panel text or the layout: the stage has a fixed
 * frame and cross-fades between two stacked layers.
 *
 * Images: the first stage image loads eagerly with high priority; thumbnails
 * are lazy; any other full-size image loads only when it is shown. All use the
 * same responsive WebP derivatives as <Photo> (lib/images.ts).
 */
import type { ViewImage } from '../data';
import type { Locale } from '../i18n/locales';
import { format, useUi } from '../i18n/ui';
import { imageSources } from '../lib/images';
import Photo from './Photo.astro';

interface Props {
  locale: Locale;
  /** Project title (names the full-screen gallery). */
  title: string;
  /** Photographs in viewing order. */
  images: ViewImage[];
}

const { locale, title, images } = Astro.props;
const t = useUi(locale).projectDetail;
const total = images.length;
const pad = (n: number) => String(n).padStart(2, '0');

const sources = await Promise.all(
  images.map(async (image) => ({ ...(await imageSources(image.src)), alt: image.alt, position: image.position })),
);
/** Stage: 8 of 12 columns from 64em, full width below. */
const STAGE_SIZES = '(min-width: 110em) 1100px, (min-width: 64em) 62vw, 100vw';
/** Largest thumbnail height (--thumb-height); thumbnail widths follow each image's ratio. */
const THUMB_MAX_HEIGHT = 224;
const thumbSizes = sources.map(({ width, height }) => `${Math.ceil((THUMB_MAX_HEIGHT * width) / height)}px`);
/** Data for the script; `<` escaped so the JSON cannot close its <script> element. */
const payload = JSON.stringify(sources).replace(/</g, '\\u003c');
---

<div
  class="viewer"
  data-viewer
  data-open-label={t.openImage}
  data-status-label={t.imageStatus}
>
  <div class="viewer__main container">
    <div class="viewer__stage-column">
      <button
        class="viewer__stage"
        type="button"
        aria-haspopup="dialog"
        aria-label={format(t.openImage, { n: 1, total })}
        data-stage
      >
        <Photo image={images[0]} sizes={STAGE_SIZES} priority class="is-shown" />
      </button>
    </div>

    <div class="viewer__panel">
      <slot />
      {
        total > 1 && (
          <div class="viewer__controls">
            <p class="viewer__count" aria-hidden="true">
              <span data-current>01</span> / {pad(total)}
            </p>
            <button class="viewer__arrow" type="button" aria-label={t.previousImage} data-prev>
              <svg viewBox="0 0 20 12" aria-hidden="true" focusable="false"><path d="M19 6H1M6 1L1 6l5 5" /></svg>
            </button>
            <span class="viewer__divider" aria-hidden="true" />
            <button class="viewer__arrow" type="button" aria-label={t.nextImage} data-next>
              <svg viewBox="0 0 20 12" aria-hidden="true" focusable="false"><path d="M1 6h18M14 1l5 5-5 5" /></svg>
            </button>
          </div>
        )
      }
    </div>
  </div>

  {
    total > 1 && (
      <div class="viewer__strip container">
        <ul class="strip" role="list" aria-label={t.images} data-strip>
          {images.map((image, i) => (
            <li class="strip__item" style={`--ratio: ${sources[i].width / sources[i].height}`}>
              <button
                class="strip__thumb"
                type="button"
                aria-label={format(t.showImage, { n: i + 1, total })}
                aria-current={i === 0 ? 'true' : undefined}
                data-thumb
              >
                <span class="strip__frame">
                  <Photo image={{ ...image, alt: '' }} sizes={thumbSizes[i]} />
                </span>
              </button>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <p class="visually-hidden" aria-live="polite" data-status></p>

  <dialog class="lightbox" aria-label={`${title} — ${t.gallery}`} data-lightbox>
    <div class="lightbox__stage" data-lightbox-stage>
      <img class="lightbox__image" alt="" decoding="async" data-lightbox-image />
    </div>
    <button class="lightbox__button lightbox__close" type="button" aria-label={t.closeGallery} autofocus data-lightbox-close>
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2 2l12 12M14 2L2 14" /></svg>
    </button>
    {
      total > 1 && (
        <>
          <button class="lightbox__button lightbox__prev" type="button" aria-label={t.previousImage} data-prev>
            <svg viewBox="0 0 20 12" aria-hidden="true" focusable="false"><path d="M19 6H1M6 1L1 6l5 5" /></svg>
          </button>
          <button class="lightbox__button lightbox__next" type="button" aria-label={t.nextImage} data-next>
            <svg viewBox="0 0 20 12" aria-hidden="true" focusable="false"><path d="M1 6h18M14 1l5 5-5 5" /></svg>
          </button>
        </>
      )
    }
    <p class="lightbox__count" aria-live="polite" data-lightbox-count></p>
  </dialog>

  <script type="application/json" data-viewer-images set:html={payload} />
</div>

<script>
  interface Item {
    src: string;
    srcset: string;
    width: number;
    height: number;
    alt: string;
    /** Focal point of the stage's 16:9 crop, for the few images that need one. */
    position?: string;
  }

  const fill = (template: string, n: number, total: number) =>
    template.replace('{n}', String(n)).replace('{total}', String(total));
  const pad = (n: number) => String(n).padStart(2, '0');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-viewer]').forEach((viewer) => {
    const json = viewer.querySelector('[data-viewer-images]')?.textContent;
    const items: Item[] = json ? JSON.parse(json) : [];
    const total = items.length;
    const stage = viewer.querySelector<HTMLButtonElement>('[data-stage]');
    const first = stage?.querySelector('img');
    const dialog = viewer.querySelector<HTMLDialogElement>('[data-lightbox]');
    const lightboxStage = viewer.querySelector<HTMLElement>('[data-lightbox-stage]');
    const lightboxImage = viewer.querySelector<HTMLImageElement>('[data-lightbox-image]');
    const lightboxCount = viewer.querySelector<HTMLElement>('[data-lightbox-count]');
    if (!stage || !first || !dialog || !lightboxStage || !lightboxImage || !lightboxCount || total === 0) return;

    const status = viewer.querySelector<HTMLElement>('[data-status]');
    const current = viewer.querySelector<HTMLElement>('[data-current]');
    const strip = viewer.querySelector<HTMLElement>('[data-strip]');
    const thumbs = [...viewer.querySelectorAll<HTMLButtonElement>('[data-thumb]')];
    const openLabel = viewer.dataset.openLabel ?? '';
    const statusLabel = viewer.dataset.statusLabel ?? '';

    const setSources = (img: HTMLImageElement, item: Item) => {
      img.width = item.width;
      img.height = item.height;
      img.srcset = item.srcset;
      img.src = item.src;
      img.alt = item.alt;
    };

    // Stage: two stacked layers; the next image decodes in the hidden one, then they cross-fade.
    let shown = first;
    first.style.objectPosition = items[0].position ?? '';
    let spare = first.cloneNode(false) as HTMLImageElement;
    spare.classList.remove('is-shown');
    spare.removeAttribute('fetchpriority');
    spare.removeAttribute('srcset');
    spare.removeAttribute('src');
    spare.loading = 'eager';
    spare.decoding = 'async';
    spare.alt = '';
    stage.append(spare);

    let index = 0;
    let stageRequest = 0;
    let lightboxRequest = 0;
    let rootOverflow = '';

    const showOnStage = async (item: Item) => {
      const request = ++stageRequest;
      setSources(spare, item);
      spare.style.objectPosition = item.position ?? '';
      await spare.decode().catch(() => undefined);
      if (request !== stageRequest) return;
      spare.classList.add('is-shown');
      shown.classList.remove('is-shown');
      [shown, spare] = [spare, shown];
    };

    /** The rendered width of an image fitted inside the full-screen frame, as a `sizes` value. */
    const lightboxSizes = (item: Item) => {
      const box = lightboxStage.getBoundingClientRect();
      return `${Math.max(1, Math.round(Math.min(box.width, (box.height * item.width) / item.height)))}px`;
    };

    const showInLightbox = async (item: Item, n: number) => {
      const request = ++lightboxRequest;
      lightboxCount.textContent = `${pad(n)} / ${pad(total)}`;
      lightboxImage.classList.remove('is-shown');
      lightboxImage.sizes = lightboxSizes(item);
      setSources(lightboxImage, item);
      await lightboxImage.decode().catch(() => undefined);
      if (request !== lightboxRequest) return;
      lightboxImage.classList.add('is-shown');
      // Warm the next image so stepping forward is instant; nothing else is fetched ahead.
      const next = items[n % total];
      if (total > 1) {
        const warm = new Image();
        warm.sizes = lightboxSizes(next);
        warm.srcset = next.srcset;
      }
    };

    /** Keep the active thumbnail visible by scrolling the strip only — never the page. */
    const revealThumb = (thumb: HTMLElement | undefined) => {
      const item = thumb?.parentElement;
      if (!strip || !item) return;
      const start = item.offsetLeft;
      const end = start + item.offsetWidth;
      const behavior: ScrollBehavior = reducedMotion.matches ? 'auto' : 'smooth';
      if (start < strip.scrollLeft) strip.scrollTo({ left: start, behavior });
      else if (end > strip.scrollLeft + strip.clientWidth) strip.scrollTo({ left: end - strip.clientWidth, behavior });
    };

    const select = (next: number) => {
      index = (next + total) % total;
      const item = items[index];
      void showOnStage(item);
      stage.setAttribute('aria-label', fill(openLabel, index + 1, total));
      if (current) current.textContent = pad(index + 1);
      thumbs.forEach((thumb, i) => (i === index ? thumb.setAttribute('aria-current', 'true') : thumb.removeAttribute('aria-current')));
      revealThumb(thumbs[index]);
      if (dialog.open) void showInLightbox(item, index + 1);
      else if (status) status.textContent = fill(statusLabel, index + 1, total);
    };

    viewer.querySelectorAll('[data-prev]').forEach((button) => button.addEventListener('click', () => select(index - 1)));
    viewer.querySelectorAll('[data-next]').forEach((button) => button.addEventListener('click', () => select(index + 1)));
    thumbs.forEach((thumb, i) => thumb.addEventListener('click', () => select(i)));

    // Full-screen gallery. showModal() makes the rest of the page inert and moves focus inside.
    stage.addEventListener('click', () => {
      dialog.showModal();
      rootOverflow = document.documentElement.style.overflow;
      document.documentElement.style.overflow = 'hidden';
      void showInLightbox(items[index], index + 1);
    });
    viewer.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    // Escape (native `cancel`) and the close button both end here: unlock the page, return focus.
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = rootOverflow;
      stage.focus({ preventScroll: true });
    });
    // Tab cycles through the gallery's own controls (the page behind is inert).
    dialog.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab') return;
      const controls = [...dialog.querySelectorAll<HTMLButtonElement>('button')];
      const firstControl = controls[0];
      const lastControl = controls[controls.length - 1];
      const inside = dialog.contains(document.activeElement);
      if (event.shiftKey && (document.activeElement === firstControl || !inside)) {
        event.preventDefault();
        lastControl.focus();
      } else if (!event.shiftKey && (document.activeElement === lastControl || !inside)) {
        event.preventDefault();
        firstControl.focus();
      }
    });

    // Touch: swipe left/right to step; a tap on the dark area around the image closes.
    let startX = 0;
    let startY = 0;
    let tracking = false;
    let swiped = false;
    lightboxStage.addEventListener('pointerdown', (event) => {
      swiped = false;
      if (event.pointerType === 'mouse') return;
      tracking = true;
      startX = event.clientX;
      startY = event.clientY;
    });
    lightboxStage.addEventListener('pointerup', (event) => {
      if (!tracking) return;
      tracking = false;
      const dx = event.clientX - startX;
      const dy = event.clientY - startY;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.5) {
        swiped = true;
        select(index + (dx < 0 ? 1 : -1));
      }
    });
    lightboxStage.addEventListener('pointercancel', () => (tracking = false));
    lightboxStage.addEventListener('click', (event) => {
      if (!swiped && event.target === lightboxStage) dialog.close();
    });

    // ← / → step through the images (page or full screen); ignored while typing or in a menu.
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey || event.defaultPrevented) return;
      const target = event.target instanceof Element ? event.target : null;
      if (!dialog.open && target?.closest('input, textarea, select, [contenteditable], details[open]')) return;
      event.preventDefault();
      select(index + (event.key === 'ArrowRight' ? 1 : -1));
    });
  });
</script>

<style>
  .viewer {
    --thumb-height: clamp(7rem, 4rem + 9vw, 14rem);
  }

  /* Stage + panel: stacked on small screens, 8 | 4 columns from 64em */
  .viewer__main {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--space-lg);
  }

  /* Fixed 16:9 frame: switching images never moves anything */
  .viewer__stage {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 0;
    overflow: hidden;
    background: var(--color-placeholder);
    border: 0;
    cursor: zoom-in;
  }

  .viewer__stage :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 380ms var(--ease);
  }

  .viewer__stage :global(img.is-shown) {
    opacity: 1;
  }

  .viewer__panel {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* 01 / 10   ←  |  → */
  .viewer__controls {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-xs);
    margin-top: var(--space-lg);
    padding-bottom: var(--space-xs);
    border-bottom: var(--rule);
  }

  .viewer__count {
    margin-right: auto;
    font-family: var(--font-numeric);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums lining-nums;
    color: var(--color-text-muted);
  }

  .viewer__arrow {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    background: none;
    border: 0;
    color: var(--color-text-primary);
    cursor: pointer;
  }

  .viewer__arrow svg,
  .lightbox__button svg {
    width: 1.25rem;
    height: auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    transition: transform var(--duration-fast) var(--ease);
  }

  .viewer__divider {
    width: 1px;
    height: 1.25rem;
    background: var(--color-rule);
  }

  @media (hover: hover) and (pointer: fine) {
    [data-prev]:hover svg {
      transform: translateX(-3px);
    }

    [data-next]:hover svg {
      transform: translateX(3px);
    }
  }

  @media (min-width: 64em) {
    .viewer__main {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gap);
    }

    .viewer__stage-column {
      grid-column: 1 / span 8;
    }

    /* The panel runs the stage's full height; controls settle at its foot */
    .viewer__panel {
      grid-column: 9 / -1;
      padding-left: var(--space-sm);
    }

    .viewer__controls {
      margin-top: auto;
    }
  }

  /* Thumbnail strip: its own horizontal scroll, native wheel/trackpad behaviour */
  .viewer__strip {
    margin-top: var(--space-md);
  }

  .strip {
    position: relative;
    display: flex;
    gap: var(--space-sm);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    padding-bottom: var(--space-sm);
    scrollbar-width: thin;
    scrollbar-color: var(--color-rule) transparent;
  }

  .strip__item {
    flex: none;
    height: var(--thumb-height);
    aspect-ratio: var(--ratio);
  }

  .strip__thumb {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    background: var(--color-placeholder);
    border: 0;
    cursor: pointer;
  }

  .strip__frame {
    display: block;
    height: 100%;
    overflow: hidden;
    opacity: 0.8;
    transition: opacity var(--duration-fast) var(--ease);
  }

  .strip__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Active image: full strength and a hairline beneath */
  .strip__thumb[aria-current='true'] .strip__frame {
    opacity: 1;
  }

  .strip__thumb[aria-current='true']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(-1 * var(--space-xs));
    height: 1px;
    background: var(--color-text-primary);
  }

  @media (hover: hover) and (pointer: fine) {
    .strip__thumb:hover .strip__frame {
      opacity: 1;
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .strip__thumb:hover .strip__frame :global(img) {
      transform: scale(1.02);
    }
  }

  /* Full-screen gallery */
  .lightbox {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-text-primary) 88%, #000);
    border: 0;
    color: var(--color-surface-primary);
    overscroll-behavior: contain;
  }

  .lightbox::backdrop {
    background: color-mix(in srgb, var(--color-text-primary) 88%, #000);
  }

  .lightbox[open] {
    animation: lightbox-in 240ms var(--ease);
  }

  @keyframes lightbox-in {
    from {
      opacity: 0;
    }
  }

  .lightbox__stage {
    position: absolute;
    top: calc(3.75rem + env(safe-area-inset-top));
    right: calc(0.75rem + env(safe-area-inset-right));
    bottom: calc(5rem + env(safe-area-inset-bottom));
    left: calc(0.75rem + env(safe-area-inset-left));
    display: grid;
    place-items: center;
    touch-action: pan-y pinch-zoom;
  }

  .lightbox__image {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    opacity: 0;
    transition: opacity 260ms var(--ease);
  }

  .lightbox__image.is-shown {
    opacity: 1;
  }

  .lightbox__button {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    opacity: 0.8;
    transition: opacity var(--duration-fast) var(--ease);
  }

  .lightbox__button:hover,
  .lightbox__button:focus-visible {
    opacity: 1;
  }

  .lightbox__button:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: -4px;
  }

  .lightbox__close {
    top: calc(0.5rem + env(safe-area-inset-top));
    right: calc(0.5rem + env(safe-area-inset-right));
  }

  .lightbox__close svg {
    width: 1rem;
  }

  /* Phones: arrows sit beside the counter, below the image */
  .lightbox__prev,
  .lightbox__next {
    bottom: calc(1rem + env(safe-area-inset-bottom));
  }

  .lightbox__prev {
    left: calc(50% - 7.5rem);
  }

  .lightbox__next {
    right: calc(50% - 7.5rem);
  }

  .lightbox__count {
    position: absolute;
    left: 50%;
    bottom: calc(1rem + env(safe-area-inset-bottom));
    display: grid;
    place-items: center;
    height: 3rem;
    transform: translateX(-50%);
    font-family: var(--font-numeric);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    font-variant-numeric: tabular-nums lining-nums;
    opacity: 0.8;
  }

  /* Larger screens: arrows at the sides, vertically centred */
  @media (min-width: 48em) {
    .lightbox__stage {
      top: calc(4rem + env(safe-area-inset-top));
      right: calc(5.5rem + env(safe-area-inset-right));
      bottom: calc(4rem + env(safe-area-inset-bottom));
      left: calc(5.5rem + env(safe-area-inset-left));
    }

    .lightbox__close {
      top: calc(1rem + env(safe-area-inset-top));
      right: calc(1rem + env(safe-area-inset-right));
    }

    .lightbox__prev,
    .lightbox__next {
      top: 50%;
      bottom: auto;
      transform: translateY(-50%);
    }

    .lightbox__prev {
      left: calc(1rem + env(safe-area-inset-left));
    }

    .lightbox__next {
      right: calc(1rem + env(safe-area-inset-right));
    }

    .lightbox__count {
      bottom: calc(0.5rem + env(safe-area-inset-bottom));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .viewer__stage :global(img),
    .lightbox__image,
    .strip__frame :global(img) {
      transition: none;
    }

    .lightbox[open] {
      animation: none;
    }
  }
</style>
