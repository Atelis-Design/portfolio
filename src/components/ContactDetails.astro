---
/**
 * Contact channels from SITE settings. Missing values render a neutral
 * "details to follow" state instead of invented data.
 */
import { SITE } from '../data';
import type { Locale } from '../i18n/locales';
import { useUi } from '../i18n/ui';

interface Props {
  locale: Locale;
  compact?: boolean;
}

const { locale, compact = false } = Astro.props;
const ui = useUi(locale).contact;
const { email, phone, location } = SITE.contact;
const instagram = SITE.social.instagram;
/** '@handle' from the profile URL, e.g. https://www.instagram.com/atelisdesign/ → @atelisdesign */
const instagramHandle = instagram ? '@' + new URL(instagram).pathname.split('/').filter(Boolean)[0] : null;

const rows = [
  { label: ui.email, value: email, href: email ? `mailto:${email}` : null },
  { label: ui.phone, value: phone, href: phone ? `tel:${phone.replace(/[^\d+]/g, '')}` : null },
  { label: ui.instagram, value: instagramHandle, href: instagram },
  { label: ui.location, value: location, href: null },
];
---

<dl class:list={['contact-details', { 'contact-details--compact': compact }]}>
  {
    rows.map((row) => (
      <div class="contact-details__row">
        <dt class="eyebrow">{row.label}</dt>
        <dd>
          {row.value ? (
            row.href ? <a href={row.href}>{row.value}</a> : row.value
          ) : (
            <span class="contact-details__pending">{ui.pending}</span>
          )}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .contact-details {
    display: grid;
    gap: var(--space-md);
  }

  .contact-details dd {
    margin-top: 0.15rem;
  }

  .contact-details:not(.contact-details--compact) dd {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  .contact-details__row:not(:first-child) {
    padding-top: var(--space-md);
    border-top: var(--rule);
  }

  .contact-details--compact {
    gap: var(--space-sm);
  }

  .contact-details--compact .contact-details__row {
    padding-top: 0;
    border-top: 0;
  }

  .contact-details__pending {
    color: var(--color-text-muted);
  }

  .contact-details--compact .contact-details__pending {
    font-style: italic;
  }
</style>
