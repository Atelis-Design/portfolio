---
/**
 * Home hero: full-width crossfading slideshow, one slide per project.
 *
 * Geometry: the desktop hero fills the viewport space between header and footer.
 * Every photograph covers that frame without transform-based zoom.
 *
 * Layout is identical for every slide: all slide texts share one grid cell in
 * the page container, so kicker, title, description and CTA sit at the same
 * coordinates; only image, title, description and (desktop) tone change.
 * Desktop: text overlaid on the image. Mobile: image, then text below it.
 *
 * Behaviour: auto-advances every 10 s (900 ms fade); pauses while focus is
 * inside, when the tab is hidden, and via the pause button; no autoplay under
 * reduced motion. Inactive slides are aria-hidden + inert. Without JavaScript
 * the first slide stays visible.
 */
import { HOME, SITE, fallbackLang, getProjectSummary, localize, viewImage } from '../data';
import type { Locale } from '../i18n/locales';
import { projectPath } from '../i18n/routes';
import { format, useUi } from '../i18n/ui';
import { imageSources } from '../lib/images';
import Photo from './Photo.astro';

interface Props {
  locale: Locale;
}

const INTERVAL_MS = 10000;

const { locale } = Astro.props;
const ui = useUi(locale);

const slides = HOME.hero.slides.flatMap((slide) => {
  const project = getProjectSummary(slide.projectId, locale);
  if (!project) return [];
  return [
    {
      title: project.title,
      href: projectPath(locale, project.id),
      image: viewImage(slide.image, locale, project.title),
      kicker: localize(slide.kicker, locale) ?? ui.home.kicker,
      kickerLang: fallbackLang(slide.kicker, locale),
      description: localize(slide.description, locale),
      descriptionLang: fallbackLang(slide.description, locale),
      tone: slide.textTone,
      mobilePosition: slide.mobilePosition,
    },
  ];
});

const total = slides.length;
const pad = (n: number) => String(n).padStart(2, '0');
const first = slides[0];
const sources = await Promise.all(slides.map((slide) => imageSources(slide.image.src)));
---

<section
  class="hero"
  aria-roledescription="carousel"
  aria-label={ui.home.carousel}
  data-hero
  data-interval={INTERVAL_MS}
>
  <h1 class="visually-hidden">{SITE.brand} — {ui.home.discipline}</h1>

  <!-- Image layer (presentational: each slide's text group carries the content) -->
  <ul class="hero__media" role="list" aria-hidden="true">
    {
      slides.map((slide, i) => (
        <li
          class:list={['hero__frame', { 'is-active': i === 0 }]}
          style={`--pos-mobile: ${slide.mobilePosition}`}
          data-slide-media
        >
          {
            i === 0 ? (
              <Photo image={slide.image} sizes="100vw" priority />
            ) : (
              <img
                alt=""
                width={sources[i].width}
                height={sources[i].height}
                sizes="100vw"
                decoding="async"
                fetchpriority="low"
                data-src={sources[i].src}
                data-srcset={sources[i].srcset}
              />
            )
          }
        </li>
      ))
    }
  </ul>

  <div class="hero__layer container">
    <div class="hero__texts">
      {
        slides.map((slide, i) => (
          <div
            class:list={['hero__text', { 'is-active': i === 0 }]}
            role="group"
            aria-roledescription="slide"
            aria-label={format(ui.home.slide, { n: i + 1, total })}
            aria-hidden={i === 0 ? undefined : 'true'}
            inert={i === 0 ? undefined : true}
            data-slide
            data-title={slide.title}
            data-href={slide.href}
            data-tone={slide.tone}
          >
            <p class="hero__kicker" lang={slide.kickerLang}>
              {slide.kicker}
            </p>
            <span class="hero__rule" aria-hidden="true" />
            <h2 class="hero__title">{slide.title}</h2>
            <p class="hero__description" lang={slide.descriptionLang}>
              {slide.description}
            </p>
            <a class="hero__cta" href={slide.href} aria-label={`${ui.home.cta}: ${slide.title}`}>
              {ui.home.cta}
              <span aria-hidden="true">→</span>
            </a>
          </div>
        ))
      }
    </div>

    <div class="hero__bar">
      <p class="hero__status" data-hero-status>
        <span class="hero__index">
          <span data-hero-current>{pad(1)}</span>
          <span class="hero__index-line" aria-hidden="true"></span>
          <span>{pad(total)}</span>
        </span>
        <a class="hero__project" href={first.href} data-hero-project>{first.title}</a>
      </p>
      <div class="hero__buttons" data-hero-buttons hidden>
        <button
          class="hero__button"
          type="button"
          data-hero-toggle
          aria-label={ui.home.pause}
          data-label-pause={ui.home.pause}
          data-label-play={ui.home.play}
        >
          <svg class="icon-pause" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
            <path d="M4 2v8M8 2v8" stroke="currentColor" stroke-width="1.4" fill="none"></path>
          </svg>
          <svg class="icon-play" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
            <path d="M3.5 2l6 4-6 4z" stroke="currentColor" stroke-width="1.3" fill="none" stroke-linejoin="round"></path>
          </svg>
        </button>
        <span class="hero__divider" aria-hidden="true"></span>
        <button class="hero__button" type="button" data-hero-prev aria-label={ui.home.previous}>
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M10 2.5L4.5 8l5.5 5.5" stroke="currentColor" stroke-width="1.4" fill="none"></path>
          </svg>
        </button>
        <button class="hero__button" type="button" data-hero-next aria-label={ui.home.next}>
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M6 2.5L11.5 8 6 13.5" stroke="currentColor" stroke-width="1.4" fill="none"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-hero]').forEach((hero) => {
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-slide]')];
    const media = [...hero.querySelectorAll<HTMLElement>('[data-slide-media]')];
    if (slides.length < 2) return;

    const current = hero.querySelector<HTMLElement>('[data-hero-current]');
    const status = hero.querySelector<HTMLElement>('[data-hero-status]');
    const project = hero.querySelector<HTMLAnchorElement>('[data-hero-project]');
    const toggle = hero.querySelector<HTMLButtonElement>('[data-hero-toggle]');
    const buttons = hero.querySelector<HTMLElement>('[data-hero-buttons]');
    const interval = Number(hero.dataset.interval) || 10000;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let index = 0;
    let timer: number | undefined;
    let warmTimer: number | undefined;
    let showRequest = 0;
    let paused = reducedMotion; // user-controlled pause (button / reduced motion)
    let held = false; // temporary hold while keyboard focus is inside the hero

    buttons?.removeAttribute('hidden');

    const loadMedia = async (next: number) => {
      const image = media[next]?.querySelector<HTMLImageElement>('img');
      const src = image?.dataset.src;
      if (!image || !src) return;
      const srcset = image.dataset.srcset;
      if (srcset) image.srcset = srcset;
      image.src = src;
      delete image.dataset.src;
      delete image.dataset.srcset;
      await image.decode().catch(() => undefined);
    };

    const show = async (next: number, announce = false) => {
      const request = ++showRequest;
      const nextIndex = (next + slides.length) % slides.length;
      await loadMedia(nextIndex);
      if (request !== showRequest) return;
      status?.setAttribute('aria-live', announce ? 'polite' : 'off');
      index = nextIndex;
      slides.forEach((slide, i) => {
        const active = i === index;
        slide.classList.toggle('is-active', active);
        media[i]?.classList.toggle('is-active', active);
        slide.toggleAttribute('inert', !active);
        if (active) slide.removeAttribute('aria-hidden');
        else slide.setAttribute('aria-hidden', 'true');
      });
      const slide = slides[index];
      if (current) current.textContent = String(index + 1).padStart(2, '0');
      if (project) {
        project.textContent = slide.dataset.title ?? '';
        if (slide.dataset.href) project.href = slide.dataset.href;
      }
    };

    const stop = () => {
      window.clearTimeout(timer);
      window.clearTimeout(warmTimer);
    };
    const start = () => {
      stop();
      if (!paused && !held) {
        warmTimer = window.setTimeout(() => void loadMedia((index + 1) % slides.length), Math.max(0, interval - 3000));
        timer = window.setTimeout(async () => {
          await show(index + 1);
          start();
        }, interval);
      }
    };

    const setPaused = (value: boolean) => {
      paused = value;
      hero.classList.toggle('is-paused', paused);
      toggle?.setAttribute('aria-label', (paused ? toggle.dataset.labelPlay : toggle.dataset.labelPause) ?? '');
      start();
    };

    hero.querySelector('[data-hero-prev]')?.addEventListener('click', () => {
      void show(index - 1, true).then(start);
    });
    hero.querySelector('[data-hero-next]')?.addEventListener('click', () => {
      void show(index + 1, true).then(start);
    });
    toggle?.addEventListener('click', () => setPaused(!paused));

    const hold = (value: boolean) => {
      held = value;
      start();
    };
    hero.addEventListener('focusin', () => hold(true));
    hero.addEventListener('focusout', (event) => {
      if (!hero.contains(event.relatedTarget as Node | null)) hold(false);
    });
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    setPaused(paused);
  });
</script>

<style>
  .hero {
    font-family: var(--font-brand);
    --tone-fg: var(--color-text-primary);
    --tone-inverse: var(--color-surface-primary);
    --tone-shadow: none;
    position: relative;
  }

  @media (min-width: 48em) and (min-height: 36em) {
    .hero {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: var(--color-placeholder);
    }

    [data-tone='light'] {
      --tone-fg: var(--color-surface-primary);
      --tone-inverse: var(--color-text-primary);
      /* soft dark edge: only noticeable where light type crosses a pale surface */
      --tone-shadow: 0 1px 2px color-mix(in srgb, var(--color-text-primary) 45%, transparent),
        0 0 12px color-mix(in srgb, var(--color-text-primary) 35%, transparent);
    }

    [data-tone='dark'] {
      --tone-fg: #000;
      --tone-inverse: var(--color-surface-primary);
      --tone-shadow: none;
    }

    /*
     * Dark-tone slides (bright interiors): a feathered, low-opacity warm wash
     * directly behind the text block. On the pale walls it is invisible; it only
     * lifts dark details (door frames, objects) that sit under the letters.
     */
    .hero__text[data-tone='dark']::before {
      content: '';
      position: absolute;
      inset: -2.5rem -5rem -2.5rem -3.5rem;
      z-index: -1;
      pointer-events: none;
      background: radial-gradient(
        ellipse 60% 55% at 40% 50%,
        color-mix(in srgb, var(--color-surface-primary) 58%, transparent),
        color-mix(in srgb, var(--color-surface-primary) 36%, transparent) 60%,
        transparent
      );
    }

    /* CTA gets a soft tone-matched fill (small button, not a veil) so it reads on any detail */
    [data-tone='light'] .hero__cta {
      background: color-mix(in srgb, var(--color-text-primary) 30%, transparent);
    }

    [data-tone='dark'] .hero__cta {
      background: color-mix(in srgb, var(--color-surface-primary) 82%, transparent);
    }
  }

  /* Image layer: every photograph covers the full media area */
  .hero__media {
    position: relative;
    height: clamp(15rem, 80vw, 28rem);
    margin: 0;
    overflow: hidden;
    background: var(--color-placeholder);
  }

  @media (min-width: 48em) and (min-height: 36em) {
    .hero__media {
      position: absolute;
      inset: 0;
      height: auto;
    }
  }

  .hero__frame {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 900ms var(--ease);
  }

  .hero__frame.is-active {
    opacity: 1;
  }

  .hero__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos-mobile, 50% 50%);
  }

  @media (min-width: 48em) and (min-height: 36em) {
    .hero__frame :global(img) {
      object-position: 50% 50%;
    }
  }

  /* Text + bar layer: the page container, shared by all slides */
  .hero__layer {
    display: grid;
  }

  @media (min-width: 48em) and (min-height: 36em) {
    .hero__layer {
      position: absolute;
      inset: 0;
      grid-template-rows: 1fr auto;
      padding-top: var(--space-xl);
      /* Text starts on column 2 of the 12-column page grid (same for every slide) */
      padding-left: calc(var(--gutter) + (100% - 2 * var(--gutter) - 11 * var(--grid-gap)) / 12 + var(--grid-gap));
    }
  }

  /* All slide texts share one grid cell → identical coordinates for every slide */
  .hero__texts {
    display: grid;
    align-content: start;
    padding-block: var(--space-md) var(--space-sm);
  }

  @media (min-width: 48em) and (min-height: 36em) {
    .hero__texts {
      width: min(36rem, 100%);
      padding: 0;
    }
  }

  .hero__text {
    position: relative;
    grid-area: 1 / 1;
    display: grid;
    /* kicker / rule / title / description (absorbs spare height) / CTA */
    grid-template-rows: auto auto auto 1fr auto;
    justify-items: start;
    align-content: start;
    row-gap: var(--space-xs);
    opacity: 0;
    pointer-events: none;
    color: var(--tone-fg);
    text-shadow: var(--tone-shadow);
    transition: opacity 900ms var(--ease);
  }

  .hero__text.is-active {
    z-index: 1;
    opacity: 1;
    pointer-events: auto;
  }

  @media (min-width: 48em) and (min-height: 36em) {
    .hero__text {
      row-gap: var(--space-md);
    }
  }

  .hero__kicker {
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  .hero__rule {
    width: 2rem;
    height: 1px;
    background: currentColor;
  }

  .hero__title {
    font-size: clamp(2.25rem, 1.4rem + 4.3vw, 5.5rem);
    line-height: 1;
  }

  .hero__description {
    max-width: 25rem;
    font-size: clamp(1.125rem, 1rem + 0.45vw, 1.375rem);
    line-height: var(--leading-snug);
    color: var(--color-text-secondary);
  }

  @media (min-width: 48em) and (min-height: 36em) {
    .hero__description {
      color: inherit;
    }
  }

  .hero__cta {
    grid-row: 5;
    align-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    margin-top: var(--space-2xs);
    padding: 0 var(--space-md);
    border: 1px solid currentColor;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    text-decoration: none;
    text-shadow: none;
    transition:
      background-color var(--duration-fast) var(--ease),
      color var(--duration-fast) var(--ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .hero__cta:hover {
      background: var(--tone-fg);
      color: var(--tone-inverse);
    }
  }

  /* Shared bar: index + project link (left), controls (right). Always dark type. */
  .hero__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-2xs);
    border-top: var(--rule);
    color: var(--color-text-primary);
  }

  @media (min-width: 48em) and (min-height: 36em) {
    .hero__bar {
      position: relative;
      z-index: 2;
      padding-block: 0 var(--space-md);
      border-top: 0;
    }

    /*
     * On the photograph both bottom corners sit in the same quiet strip: light warm
     * surface + hairline border, identical height, so counter, label and controls
     * read on every image and mirror each other.
     */
    .hero__status,
    .hero__buttons {
      min-height: 2.75rem;
      background: color-mix(in srgb, var(--color-surface-primary) 86%, transparent);
      border: 1px solid color-mix(in srgb, var(--color-text-primary) 14%, transparent);
    }

    /* Fixed minimum width: the strip does not change size between project names */
    .hero__status {
      min-width: 14rem;
      padding-inline: var(--space-md);
    }
  }

  .hero__status {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    white-space: nowrap;
    gap: 0 var(--space-lg);
    font-size: var(--text-sm);
    letter-spacing: 0.12em;
  }

  /* Counter digits use the numeral face (IBM Plex Sans), tabular and lining */
  .hero__index {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-numeric);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums lining-nums;
  }

  .hero__index-line {
    width: 1.5rem;
    height: 1px;
    background: currentColor;
  }

  .hero__project {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--text-md);
    letter-spacing: 0.02em;
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .hero__project:hover {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.25em;
    }
  }

  /* Very narrow screens: the title is shown right above, so the bar keeps only the index */
  @media (max-width: 23.99em) {
    .hero__project {
      display: none;
    }
  }

  /* Controls: pause/play · prev · next, 44px targets (strip styling: see .hero__bar) */
  .hero__buttons {
    display: flex;
    align-items: center;
    flex: none;
  }

  .hero__buttons[hidden] {
    display: none;
  }

  .hero__button {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .hero__button:hover {
      background: var(--color-surface-primary);
    }
  }

  .hero__button:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: -5px;
    background: var(--color-surface-primary);
  }

  .hero__divider {
    width: 1px;
    height: 1rem;
    background: currentColor;
    opacity: 0.4;
  }

  .hero .icon-play,
  .hero.is-paused .icon-pause {
    display: none;
  }

  .hero.is-paused .icon-play {
    display: block;
  }

  .hero :focus-visible {
    outline-color: currentColor;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__frame,
    .hero__text,
    .hero__bar {
      transition: none;
    }
  }
</style>
