---
/**
 * Editorial gallery. Renders a small vocabulary of blocks:
 *   image  — bleed | wide | inset | detail (detail/inset can align start/end)
 *   row    — 2–3 images at equal height (column widths follow aspect ratios)
 *   text   — a short text interruption
 * Images are never cropped here: every image keeps its native aspect ratio.
 */
import type { ViewBlock } from '../data';
import { imageSize } from '../lib/images';
import Photo from './Photo.astro';

interface Props {
  blocks: ViewBlock[];
}

const { blocks } = Astro.props;

const imageSizes = {
  bleed: '100vw',
  wide: '(min-width: 110em) 1700px, 100vw',
  inset: '(min-width: 64em) 66vw, 100vw',
  detail: '(min-width: 64em) 50vw, 100vw',
} as const;

/** Aspect ratios for row blocks (index-aligned with `blocks`). */
const rowRatios = await Promise.all(
  blocks.map((block) =>
    block.type === 'row' ? Promise.all(block.images.map(async (image) => (await imageSize(image.src)).ratio)) : null,
  ),
);

function rowSizes(ratios: number[], size: 'wide' | 'inset'): string[] {
  const total = ratios.reduce((sum, ratio) => sum + ratio, 0);
  const span = size === 'wide' ? 100 : 84;
  return ratios.map((ratio) => `(min-width: 40em) ${Math.ceil((span * ratio) / total)}vw, 100vw`);
}
---

<div class="gallery">
  {
    blocks.map((block, index) => {
      if (block.type === 'text') {
        return (
          <div class="gallery__text container grid">
            <p class="statement">{block.text}</p>
          </div>
        );
      }

      if (block.type === 'row') {
        const ratios = rowRatios[index] ?? [];
        const sizes = rowSizes(ratios, block.size);
        return (
          <div class:list={['container', 'gallery__row-wrap', `gallery__row-wrap--${block.size}`]}>
            <div class="gallery__row">
              {block.images.map((image, i) => (
                <figure class="gallery__row-item" style={`--ratio: ${ratios[i]}`}>
                  <Photo image={image} sizes={sizes[i]} />
                </figure>
              ))}
            </div>
          </div>
        );
      }

      const { image, size, align = 'start' } = block;
      if (size === 'bleed') {
        return (
          <figure class="gallery__bleed">
            <Photo image={image} sizes={imageSizes.bleed} />
          </figure>
        );
      }

      return (
        <div class="container grid">
          <figure class:list={['gallery__image', `gallery__image--${size}`, `gallery__image--${align}`]}>
            <Photo image={image} sizes={imageSizes[size]} />
          </figure>
        </div>
      );
    })
  }
</div>

<style>
  .gallery {
    display: grid;
    gap: clamp(1.5rem, 0.8rem + 3.5vw, 6rem);
  }

  .gallery img {
    width: 100%;
  }

  .gallery__bleed img {
    width: 100%;
  }

  .gallery__text {
    padding-block: var(--space-xl);
  }

  .gallery__row {
    display: grid;
    gap: var(--grid-gap);
  }

  @media (min-width: 40em) {
    .gallery__row {
      display: flex;
      align-items: flex-start;
    }

    /* flex-grow proportional to aspect ratio ⇒ equal heights, no cropping */
    .gallery__row-item {
      flex: var(--ratio) 1 0;
      min-width: 0;
    }
  }

  @media (min-width: 64em) {
    .gallery__text .statement {
      grid-column: 4 / span 7;
    }

    .gallery__image--inset.gallery__image--start {
      grid-column: 2 / span 8;
    }

    .gallery__image--inset.gallery__image--end {
      grid-column: 5 / span 8;
    }

    .gallery__image--detail.gallery__image--start {
      grid-column: 1 / span 6;
    }

    .gallery__image--detail.gallery__image--end {
      grid-column: 7 / span 6;
    }

    .gallery__row-wrap--inset .gallery__row {
      width: calc(100% * 10 / 12);
      margin-inline: auto;
    }
  }
</style>
